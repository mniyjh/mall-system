@startuml
left to right direction
skinparam defaultFontName "Noto Sans SC"
skinparam actorStyle hollow
skinparam shadowing false
skinparam dpi 150
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
}

actor "管理员" as Admin
rectangle "商城系统" {
  usecase "用户管理" as UC1
  usecase "角色管理" as UC2
}
Admin --> UC1
Admin --> UC2
@enduml
